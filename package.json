{
    "name": "com.avinash.sprintboard.SprintBoardLite",
    "scripts": {
        "build": "mbt build --mtar com.avinash.sprintboard.SprintBoardLite.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/com.avinash.sprintboard.SprintBoardLite.mtar --retries 0",
        "lint": "npm run lint --workspaces --if-present",
        "ui5lint": "npm run ui5lint --workspaces --if-present",
        "start:SprintBoardLite": "npm start --workspace SprintBoardLite",
        "qunit": "fiori run --open test/unitTests.qunit.html"
    },
    "dependencies": {
        "mbt": "^1"
    },
    "workspaces": [
        "SprintBoardLite"
    ]
}